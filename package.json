{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "tailwind:init": "npx tailwindcss init -p",
        "format": "prettier --write \"resources/**/*.{js,vue,css,blade.php}\"",
        "format:check": "prettier --check \"resources/**/*.{js,vue,css,blade.php}\"",
        "lint:css": "stylelint \"resources/**/*.css\" --fix",
        "clean": "rimraf node_modules public/css public/js public/mix-manifest.json"
    },
    "devDependencies": {
        "@vue/compiler-sfc": "^3.5.43",
        "autoprefixer": "^10.6.1",
        "axios": "^0.21",
        "bootstrap": "^4.6.0",
        "jquery": "^3.6",
        "laravel-mix": "^6.0.49",
        "lodash": "^4.17.19",
        "popper.js": "^1.16.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "resolve-url-loader": "^3.1.2",
        "sass": "^1.105.0",
        "sass-loader": "^11.0.1",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^3.4.19",
        "vue": "^3.5.43",
        "vue-loader": "^17.4.2",
        "vue-template-compiler": "^2.6.12",
        "webpack": "5.93.0"
    },
    "dependencies": {
        "flowbite": "^4.0.2",
        "laravel-vue-pagination": "^2.3.1",
        "moment": "^2.29.1",
        "vform": "^2.1.1",
        "vue-router": "^3.5.2",
        "vuejs-datepicker": "^1.6.2"
    }
}
